# Copia este archivo a infra/apps/.env y ajusta lo que corresponda.
# NUNCA subas el .env real al repositorio.
#
# Tenant: ejemploDuoc (workforce)
# Registro backend: pedidos360-api

# dev   -> tokens locales emitidos por el BFF (/dev/token). Para demo sin Azure.
# azure -> validacion real contra Microsoft Entra ID.
SPRING_PROFILES_ACTIVE=azure

# Directory (tenant) ID: 41f0982b-bfd4-40ea-8b24-cd683cd0f362
# OJO: este issuer (v2.0) solo es correcto si pedidos360-api tiene
# requestedAccessTokenVersion: 2 en su manifiesto. Con v1 el iss del token seria
# https://sts.windows.net/41f0982b-bfd4-40ea-8b24-cd683cd0f362/
PEDIDOS360_ISSUER_URI=https://login.microsoftonline.com/41f0982b-bfd4-40ea-8b24-cd683cd0f362/v2.0

# Los DOS valores separados por coma: el Application ID URI y el Application
# (client) ID de pedidos360-api. El claim aud sera uno u otro segun la version
# del access token, asi que aceptando ambos funciona en los dos casos.
PEDIDOS360_AUDIENCES=api://pedidos360-api,1e8d01fa-bd60-4403-ae34-4288007ed4dd

# Detras de AWS API Gateway debe ir en false: el gateway ya agrega las cabeceras
# CORS y duplicarlas hace que el navegador rechace la respuesta.
# Claves publicas del tenant. Definirlo hace que el arranque no dependa de que
# Entra ID responda en ese instante (importante con 6 contenedores a la vez).
PEDIDOS360_JWK_SET_URI=https://login.microsoftonline.com/41f0982b-bfd4-40ea-8b24-cd683cd0f362/discovery/v2.0/keys

PEDIDOS360_CORS_ENABLED=false

# En EC2: IP PRIVADA de cada instancia (ec2-mq y ec2-kafka).
RABBITMQ_HOST=pedidos360-rabbitmq
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=pedidos360
KAFKA_BOOTSTRAP=pedidos360-kafka:29092

PEDIDOS360_RABBIT_ENABLED=true
PEDIDOS360_KAFKA_ENABLED=true
